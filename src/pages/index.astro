  <!-- ==============================================================================
       RAYCAST SPOTLIGHT & KEYBOARD INTERACTION ENGINE (VANILLA JS)
       ============================================================================== -->
  <script is:inline>
    // 1. Mouse-following global ambient spotlight
    window.addEventListener('mousemove', (e) => {
      document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
      document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
    });

    // 2. Individual Card Spotlight Border illumination
    document.querySelectorAll('.raycast-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--card-x', `${x}px`);
        card.style.setProperty('--card-y', `${y}px`);
      });
    });

    // 3. Tactile Keyboard Navigation (1-5, G, T)
    window.addEventListener('keydown', (e) => {
      // Don't intercept if user is typing in an input
      if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

      const key = e.key.toLowerCase();
      if (['1', '2', '3', '4', '5'].includes(key)) {
        e.preventDefault();
        const target = document.getElementById(`app-${key}`);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.style.transition = 'box-shadow 0.3s ease';
          target.style.boxShadow = '0 0 50px rgba(0, 245, 160, 0.45)';
          setTimeout(() => {
            target.style.boxShadow = '';
          }, 1200);
        }
      } else if (key === 'g') {
        window.open('https://github.com/NikkoWebDev/nt-suite', '_blank');
      } else if (key === 't') {
        const term = document.getElementById('terminal');
        if (term) term.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // 4. Scroll spy for dock indicator
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          if (id && id.startsWith('app-')) {
            const num = id.replace('app-', '');
            document.querySelectorAll('.dock-item').forEach(d => d.classList.remove('active'));
            const activeDock = document.querySelector(`.dock-item[data-app="${num}"]`);
            if (activeDock) activeDock.classList.add('active');
          }
        }
      });
    }, { threshold: 0.4 });

    for (let i = 1; i <= 5; i++) {
      const el = document.getElementById(`app-${i}`);
      if (el) observer.observe(el);
    }
  </script>
