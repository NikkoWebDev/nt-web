---
import Layout from '../layouts/Layout.astro';

const apps = [
  {
    name: "Spotin't",
    tagline: "Cliente de música puro en Jetpack Compose",
    icon: "/icons/spotint.png",
    status: "Nativo FOSS",
    statusColor: "mint",
    description: "Reemplazo completo de Spotify desarrollado desde cero en Kotlin 2.2 y Media3. Erradica absolutamente podcasts y audiolibros para dejar exclusivamente música en alta fidelidad.",
    specs: [
      { label: "Tamaño APK", value: "24 MB (vs 100MB+)" },
      { label: "Audio", value: "FLAC 24-bit / Hi-Fi" },
      { label: "UI Engine", value: "Compose + RenderEffect" },
      { label: "Backend", value: "Spotify + InnerTube" }
    ],
    features: [
      "Cero interrupciones comerciales ni banners",
      "Extractor YouTube Music fallback automático",
      "Fondos dinámicos Palette con caché en segundo plano",
      "Mini-player flotante estilo píldora acristalada"
    ],
    command: "cd Spotin't/spotui-src && ./gradlew assembleDebug",
    repoLink: "https://github.com/NikkoWebDev/nt-suite/tree/main/Spotin't"
  },
  {
    name: "Youtun't",
    tagline: "YouTube ReVanced Engine con estética Obsidian",
    icon: "/icons/youtunt.png",
    status: "ReVanced v6",
    statusColor: "cyan",
    description: "Build de YouTube sin anuncios ni distracciones algorítmicas sobre el bundle oficial de ReVanced. Erradica la bandeja de Shorts y optimiza la decodificación de video en hardware.",
    specs: [
      { label: "Bloqueador", value: "SponsorBlock nativo" },
      { label: "Codec Preferido", value: "VP9 Hardware (Frío)" },
      { label: "Shorts", value: "Totalmente suprimidos" },
      { label: "Background", value: "Reproducción activa" }
    ],
    features: [
      "Eliminación total de anuncios pre-roll, mid-roll y popups",
      "Seekbar personalizada en Verde Menta Neón (#00F5A0)",
      "Supresión de botones inútiles: Create, Remix, Thanks, Shopping",
      "Firma persistente BKS con validador estricto en CLI"
    ],
    command: "./youtunt build s21",
    repoLink: "https://github.com/NikkoWebDev/nt-suite/tree/main/Youtun't"
  },
  {
    name: "Instan't",
    tagline: "Instagram con Ghost Mode y tema Mint Glass autosembrado",
    icon: "/icons/instant.png",
    status: "LSPatch L2",
    statusColor: "mint",
    description: "Instagram modificado sin root mediante motor Xposed integrado. Suprime la telemetría de Facebook Graph y aplica la paleta Mint Glass canónica de 15 slots al arrancar.",
    specs: [
      { label: "Mod Engine", value: "InstaEclipse Legacy" },
      { label: "Bypass", value: "Nivel 2 (openat + pm)" },
      { label: "Tema", value: "Auto-seeder SharedPreferences" },
      { label: "Analytics", value: "Trackers bloqueados" }
    ],
    features: [
      "Erradicación absoluta del botón y sugerencias de Meta AI",
      "Ghost Mode: Ocultar visto en DMs, historias y typing",
      "Anti-delete de mensajes directos revocados",
      "Descargas multimedia en resolución original"
    ],
    command: "./instant build s21",
    repoLink: "https://github.com/NikkoWebDev/nt-suite/tree/main/Instan't"
  },
  {
    name: "Tikton't",
    tagline: "Feed limpio sin anuncios, livestreams ni ruido",
    icon: "/icons/tiktont.png",
    status: "ReVanced v6",
    statusColor: "cyan",
    description: "Herramienta CLI con 13 parches oficiales verificados para TikTok. Transforma la app más adictiva y pesada de Android en un visor limpio, enfocado y respetuoso con la batería.",
    specs: [
      { label: "UI Mode", value: "Remember Clear Display" },
      { label: "Descargas", value: "Sin marca de agua" },
      { label: "Velocidad", value: "Playback speed global" },
      { label: "Telemetría", value: "Sentry SDK desactivado" }
    ],
    features: [
      "Eliminación de anuncios, banners de shopping y transmisiones en vivo",
      "Modo pantalla limpia persistente (cero iconos tapando el video)",
      "Seekbar de progreso forzada en todos los clips",
      "Assets adaptativos Mint Glass generados para todas las densidades"
    ],
    command: "./tiktont build s21",
    repoLink: "https://github.com/NikkoWebDev/nt-suite/tree/main/Tikton't"
  },
  {
    name: "Wasapn't",
    tagline: "Privacidad pasiva en memoria RAM para WhatsApp",
    icon: "/icons/wasapnt.png",
    status: "En Desarrollo",
    statusColor: "warning",
    description: "Motor de inyección local sobre WhatsApp oficial mediante WaEnhancerX. Preserva los mensajes borrados y omite la visualización única sin alterar el cifrado de extremo a extremo Signal Protocol.",
    specs: [
      { label: "Cifrado", value: "Signal E2EE 100% Intacto" },
      { label: "Seguridad", value: "Hooks locales pasivos en RAM" },
      { label: "Canales", value: "Preservados (keepChannels)" },
      { label: "Meta AI", value: "Completamente erradicado" }
    ],
    features: [
      "Anti-delete: Los mensajes eliminados se mantienen en el SQLite local",
      "View-Once bypass: Fotos y videos efímeros sin límite de apertura",
      "Desactivación de FLAG_SECURE para capturas de pantalla",
      "Firma criptográfica RSA fija para soportar actualizaciones de Play Store"
    ],
    command: "./wasapnt status && ./wasapnt build",
    repoLink: "https://github.com/NikkoWebDev/nt-suite/tree/main/Wasapn't"
  }
];
---

<Layout>
  <!-- Navigation Header -->
  <header style="position: sticky; top: 0; z-index: 50; padding: 18px 24px;">
    <div class="glass-panel" style="max-width: 1200px; margin: 0 auto; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; border-radius: 9999px;">
      <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
        <span style="display: inline-flex; width: 34px; height: 34px; border-radius: 10px; background: rgba(61, 255, 160, 0.15); border: 1px solid rgba(61, 255, 160, 0.4); align-items: center; justify-content: center; font-weight: 700; color: var(--mint-primary); font-family: var(--font-display);">
          n't
        </span>
        <span class="font-display" style="font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em;">
          nt.<span style="color: var(--mint-primary);">nikko.dev</span>
        </span>
      </a>

      <nav style="display: flex; align-items: center; gap: 28px;">
        <a href="#apps" style="color: var(--text-secondary); text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 0.2s ease;">Apps</a>
        <a href="#hardware" style="color: var(--text-secondary); text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 0.2s ease;">S21 FE Tuned</a>
        <a href="#tokens" style="color: var(--text-secondary); text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 0.2s ease;">Mint Glass 2.0</a>
        <a href="#build" style="color: var(--text-secondary); text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 0.2s ease;">Build CLI</a>
      </nav>

      <a href="https://github.com/NikkoWebDev/nt-suite" target="_blank" rel="noopener" class="glass-pill" style="text-decoration: none;">
        <span>GitHub</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <main style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 100px;">
    <section style="text-align: center; padding: 60px 0 80px;">
      <div style="display: inline-block; margin-bottom: 24px;">
        <span class="glass-pill">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--mint-primary); box-shadow: 0 0 10px var(--mint-primary);"></span>
          Android De-bloated Suite • Samsung S21 FE Tuned
        </span>
      </div>

      <h1 class="font-display" style="font-size: clamp(2.8rem, 6vw, 4.8rem); line-height: 1.08; font-weight: 800; letter-spacing: -0.04em; max-width: 950px; margin: 0 auto 28px;">
        Las apps más pesadas de Android, <span style="color: var(--mint-primary); text-shadow: 0 0 40px rgba(61, 255, 160, 0.35);">reconstruidas sin basura</span>.
      </h1>

      <p style="font-size: 1.25rem; line-height: 1.6; color: var(--text-secondary); max-width: 760px; margin: 0 auto 48px;">
        Cero anuncios forzados, cero telemetría invasiva y cero consumo parasitante. Diseñadas bajo la estética acristalada <strong>Mint Glass</strong> y optimizadas a bajo nivel para mantener 120 FPS sin thermal throttling.
      </p>

      <!-- Live Counters -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 60px;">
        <div class="glass-panel" style="padding: 24px; text-align: center;">
          <div class="font-mono" style="font-size: 2.2rem; font-weight: 700; color: var(--mint-primary); margin-bottom: 6px;">0</div>
          <div style="font-size: 0.9rem; color: var(--text-secondary);">Anuncios o Banners</div>
        </div>
        <div class="glass-panel" style="padding: 24px; text-align: center;">
          <div class="font-mono" style="font-size: 2.2rem; font-weight: 700; color: var(--mint-primary); margin-bottom: 6px;">120 Hz</div>
          <div style="font-size: 0.9rem; color: var(--text-secondary);">Fluidez Dynamic AMOLED</div>
        </div>
        <div class="glass-panel" style="padding: 24px; text-align: center;">
          <div class="font-mono" style="font-size: 2.2rem; font-weight: 700; color: var(--mint-primary); margin-bottom: 6px;">0%</div>
          <div style="font-size: 0.9rem; color: var(--text-secondary);">Subpíxeles OLED encendidos en negro</div>
        </div>
        <div class="glass-panel" style="padding: 24px; text-align: center;">
          <div class="font-mono" style="font-size: 2.2rem; font-weight: 700; color: var(--mint-primary); margin-bottom: 6px;">5 Apps</div>
          <div style="font-size: 0.9rem; color: var(--text-secondary);">Cubriendo tu uso diario</div>
        </div>
      </div>

      <!-- Showcase Hero Visual -->
      <div class="glass-panel" style="padding: 16px; border-radius: 28px; overflow: hidden; position: relative;">
        <img 
          src="/images/spotint_showcase.png" 
          alt="Spotin't Showcase - Interfaz Mint Glass en Jetpack Compose" 
          style="width: 100%; height: auto; border-radius: 18px; display: block;" 
          loading="eager"
        />
        <div style="position: absolute; bottom: 36px; left: 36px; right: 36px; display: flex; justify-content: space-between; align-items: center; background: rgba(7, 13, 10, 0.85); backdrop-filter: blur(16px); padding: 14px 24px; border-radius: 16px; border: 1px solid rgba(61, 255, 160, 0.3);">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="width: 10px; height: 10px; border-radius: 50%; background: var(--mint-primary);"></span>
            <span class="font-mono" style="font-size: 0.9rem; color: var(--text-primary);">Spotin't corriendo en vivo • FLAC 24-bit / 96 kHz • Jetpack Compose</span>
          </div>
          <span class="glass-pill" style="font-size: 0.78rem;">S21 FE Dynamic AMOLED 2X</span>
        </div>
      </div>
    </section>

    <!-- Apps Showcase Section -->
    <section id="apps" style="padding: 60px 0;">
      <div style="margin-bottom: 48px; text-align: center;">
        <span class="glass-pill" style="margin-bottom: 12px;">El Ecosistema Completo</span>
        <h2 class="font-display" style="font-size: 2.8rem; font-weight: 700; letter-spacing: -0.03em;">Las 5 Herramientas de la Suite</h2>
        <p style="color: var(--text-secondary); max-width: 650px; margin: 12px auto 0;">
          Cada proyecto reemplaza una app privativa masiva, devolviendo el control del procesador, la memoria y la batería.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: 32px;">
        {apps.map((app) => (
          <div class="glass-panel" style="padding: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 36px; align-items: center;">
            <div>
              <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px;">
                <img src={app.icon} alt={app.name} style="width: 56px; height: 56px; border-radius: 14px; border: 1px solid rgba(61, 255, 160, 0.3); background: rgba(0,0,0,0.4);" />
                <div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <h3 class="font-display" style="font-size: 1.8rem; font-weight: 700; letter-spacing: -0.02em;">{app.name}</h3>
                    <span class="glass-pill" style={app.statusColor === 'warning' ? "color: #FFAE42; border-color: rgba(255, 174, 66, 0.3); background: rgba(255, 174, 66, 0.1);" : ""}>
                      {app.status}
                    </span>
                  </div>
                  <div style="color: var(--mint-primary); font-size: 0.95rem; font-weight: 500;">{app.tagline}</div>
                </div>
              </div>

              <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 24px; font-size: 1.02rem;">
                {app.description}
              </p>

              <!-- Features checklist -->
              <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px;">
                {app.features.map((f) => (
                  <div style="display: flex; align-items: flex-start; gap: 10px; font-size: 0.92rem; color: var(--text-primary);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--mint-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{f}</span>
                  </div>
                ))}
              </div>

              <div style="display: flex; gap: 14px; flex-wrap: wrap;">
                <a href={app.repoLink} target="_blank" rel="noopener" class="glass-pill" style="padding: 10px 18px; text-decoration: none;">
                  <span>Ver código en GitHub</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
              </div>
            </div>

            <!-- Specs & Code Box -->
            <div style="display: flex; flex-direction: column; gap: 18px;">
              <div style="background: rgba(0, 0, 0, 0.45); border: 1px solid var(--glass-border-subtle); border-radius: 16px; padding: 20px;">
                <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 14px; letter-spacing: 0.05em;">Especificaciones Clave</div>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;">
                  {app.specs.map((s) => (
                    <div>
                      <div style="font-size: 0.78rem; color: var(--text-secondary);">{s.label}</div>
                      <div class="font-mono" style="font-size: 0.92rem; font-weight: 600; color: var(--text-primary); margin-top: 2px;">{s.value}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div style="background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(61, 255, 160, 0.2); border-radius: 14px; padding: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                  <span style="font-size: 0.76rem; color: var(--text-muted);" class="font-mono">COMANDO CLI DE BUILD</span>
                  <span style="font-size: 0.7rem; color: var(--mint-primary);" class="font-mono">TERMINAL READY</span>
                </div>
                <code class="font-mono" style="display: block; font-size: 0.88rem; color: var(--mint-primary); word-break: break-all;">
                  $ {app.command}
                </code>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Hardware Optimization Section (S21 FE Deep Dive) -->
    <section id="hardware" style="padding: 60px 0;">
      <div class="glass-panel" style="padding: 48px; border-radius: 32px; position: relative; overflow: hidden;">
        <div style="max-width: 780px;">
          <span class="glass-pill" style="margin-bottom: 16px;">Arquitectura de Bajo Nivel</span>
          <h2 class="font-display" style="font-size: 2.6rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 20px;">
            Optimizada para el desafío térmico del Galaxy S21 FE
          </h2>
          <p style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6; margin-bottom: 32px;">
            Tanto el <strong>Snapdragon 888</strong> como el <strong>Exynos 2100</strong> fueron fabricados en el nodo de 5 nm de Samsung Foundry, célebres por disparar su temperatura bajo sobrecarga continua. La suite <code>n't</code> ataca la causa raíz:
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
          <div style="background: rgba(0, 0, 0, 0.4); border: 1px solid var(--glass-border-subtle); border-radius: 18px; padding: 24px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(61, 255, 160, 0.12); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--mint-primary);">
              ⚡
            </div>
            <h4 class="font-display" style="font-size: 1.2rem; font-weight: 600; margin-bottom: 8px;">Dynamic AMOLED 2X a 120 Hz</h4>
            <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.5;">
              Al usar fondos Dark Obsidian (<code>#070D0A</code>), el 85% de los subpíxeles permanecen físicamente apagados con consumo 0 mW. Sin recomposiciones innecesarias de Compose en listas.
            </p>
          </div>

          <div style="background: rgba(0, 0, 0, 0.4); border: 1px solid var(--glass-border-subtle); border-radius: 18px; padding: 24px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(61, 255, 160, 0.12); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--mint-primary);">
              ❄️
            </div>
            <h4 class="font-display" style="font-size: 1.2rem; font-weight: 600; margin-bottom: 8px;">Decodificación VP9 & Opus</h4>
            <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.5;">
              Forzado de decodificadores por hardware directo a MediaCodec. En YouTube, VP9 reduce hasta 4°C frente al decodificador AV1 por software que drena la batería.
            </p>
          </div>

          <div style="background: rgba(0, 0, 0, 0.4); border: 1px solid var(--glass-border-subtle); border-radius: 18px; padding: 24px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(61, 255, 160, 0.12); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--mint-primary);">
              🛡️
            </div>
            <h4 class="font-display" style="font-size: 1.2rem; font-weight: 600; margin-bottom: 8px;">Cero WakeLocks Parasitarios</h4>
            <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.5;">
              Al erradicar los SDKs de telemetría de Meta, Google Firebase y ByteDance Sentry, el dispositivo entra en <strong>Deep Sleep</strong> continuo cuando la pantalla se apaga.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Mint Glass 2.0 Tokens Section -->
    <section id="tokens" style="padding: 60px 0;">
      <div style="margin-bottom: 40px; text-align: center;">
        <span class="glass-pill" style="margin-bottom: 12px;">tokens.json • Especificación 2.0</span>
        <h2 class="font-display" style="font-size: 2.6rem; font-weight: 700; letter-spacing: -0.03em;">Sistema de Diseño Mint Glass</h2>
        <p style="color: var(--text-secondary); max-width: 600px; margin: 10px auto 0;">
          Los grados de cristal matemáticos implementados en Kotlin, LSPatch y Web.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
        <div class="glass-panel" style="padding: 24px; background: rgba(13, 26, 20, 0.45);">
          <div class="font-mono" style="color: var(--mint-primary); font-size: 0.85rem; margin-bottom: 6px;">GRADO G1 • SUBTLE</div>
          <h4 style="font-size: 1.1rem; margin-bottom: 8px;">Superficie Tonal</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 14px;">Opacidad al 45% con borde blanco del 12%. Usado en divisores y tabs secundarios.</p>
          <code class="font-mono" style="font-size: 0.76rem; color: var(--text-muted);">rgba(13, 26, 20, 0.45)</code>
        </div>

        <div class="glass-panel" style="padding: 24px; background: rgba(19, 36, 28, 0.65);">
          <div class="font-mono" style="color: var(--mint-primary); font-size: 0.85rem; margin-bottom: 6px;">GRADO G2 • SOFT GLASS</div>
          <h4 style="font-size: 1.1rem; margin-bottom: 8px;">Tarjetas de Feed</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 14px;">Contenedores con gradiente suave cenital y radio de 20dp adaptativo.</p>
          <code class="font-mono" style="font-size: 0.76rem; color: var(--text-muted);">rgba(19, 36, 28, 0.65)</code>
        </div>

        <div class="glass-panel" style="padding: 24px; background: rgba(20, 43, 33, 0.75); border-color: rgba(61, 255, 160, 0.35);">
          <div class="font-mono" style="color: var(--mint-primary); font-size: 0.85rem; margin-bottom: 6px;">GRADO G3 • CARD GLASS</div>
          <h4 style="font-size: 1.1rem; margin-bottom: 8px;">Paneles Elevados</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 14px;">Borde reflectivo de 1px esmeralda, elevación 12dp y sombra amortiguada.</p>
          <code class="font-mono" style="font-size: 0.76rem; color: var(--text-muted);">rgba(20, 43, 33, 0.75)</code>
        </div>

        <div class="glass-panel" style="padding: 24px; background: rgba(26, 52, 40, 0.85); border-color: var(--mint-primary); box-shadow: 0 0 30px rgba(61, 255, 160, 0.2);">
          <div class="font-mono" style="color: var(--mint-primary); font-size: 0.85rem; margin-bottom: 6px;">GRADO G4 • HERO GLASS</div>
          <h4 style="font-size: 1.1rem; margin-bottom: 8px;">Cápsula Flotante Activa</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 14px;">Resplandor neón menta al 20%, halo de luz central y controles activos.</p>
          <code class="font-mono" style="font-size: 0.76rem; color: var(--text-muted);">shadow(spotColor = #3DFFA0)</code>
        </div>
      </div>
    </section>

    <!-- Build Station Section -->
