---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Global Raycast Spotlight Ambient -->
  <div style="position: absolute; top: 0; left: 15%; width: 600px; height: 450px; background: radial-gradient(circle, rgba(0, 245, 160, 0.08) 0%, transparent 70%); filter: blur(90px); pointer-events: none;"></div>
  <div style="position: absolute; top: 120px; right: 10%; width: 650px; height: 500px; background: radial-gradient(circle, rgba(0, 229, 255, 0.06) 0%, transparent 70%); filter: blur(100px); pointer-events: none;"></div>

  <!-- Top Sticky Header -->
  <header style="position: sticky; top: 16px; z-index: 50; padding: 0 24px; max-width: 1320px; margin: 0 auto;">
    <div class="raycast-card" style="padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; border-radius: 9999px;">
      <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
        <span style="display: inline-flex; width: 32px; height: 32px; border-radius: 8px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem; color: #FFF; font-family: var(--font-display);">
          n't
        </span>
        <span class="font-editorial" style="font-size: 1.15rem; letter-spacing: -0.02em;">
          nt.<span style="color: var(--accent-mint);">nikko.dev</span>
        </span>
      </a>

      <!-- Quick Status -->
      <div style="display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-secondary);">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent-mint); box-shadow: 0 0 10px var(--accent-mint);"></span>
        <span>SUITE V2.0 • 5 APPS ONLINE</span>
      </div>

      <!-- Navigation & Action -->
      <div style="display: flex; align-items: center; gap: 16px;">
        <a href="#apps" style="color: var(--text-secondary); text-decoration: none; font-size: 0.88rem; font-weight: 500; transition: color 0.2s;">Apps</a>
        <a href="#telemetry" style="color: var(--text-secondary); text-decoration: none; font-size: 0.88rem; font-weight: 500; transition: color 0.2s;">S21 FE</a>
        <a href="https://github.com/NikkoWebDev/nt-suite" target="_blank" rel="noopener" class="raycast-btn raycast-btn-secondary" style="padding: 7px 14px; font-size: 0.82rem; border-radius: 9999px;">
          <span>GitHub</span>
          <kbd>G</kbd>
        </a>
      </div>
    </div>
  </header>

  <main style="max-width: 1320px; margin: 0 auto; padding: 60px 24px 140px;">

    <!-- ==============================================================================
         KOTO MONUMENTAL EDITORIAL HERO
         ============================================================================== -->
    <section style="padding: 60px 0 80px; border-bottom: 1px solid var(--border-subtle);">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 28px;">
        <span class="koto-badge active-mint">
          <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent-mint);"></span>
          00 // MANIFIESTO DE HARDWARE
        </span>
        <span class="koto-badge">SAMSUNG GALAXY S21 FE OPTIMIZED</span>
        <span class="koto-badge">CERO ANALYTICS</span>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: 28px;">
        <h1 class="koto-huge-title">
          EL HARDWARE ES TUYO.<br />
          <span style="color: var(--text-muted);">LAS APPS YA NO MANDAN.</span>
        </h1>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; margin-top: 10px; align-items: end;">
          <p style="font-size: 1.28rem; line-height: 1.55; color: var(--text-secondary); max-width: 680px;">
            Reconstrucción sin concesiones de las 5 aplicaciones más abusivas del ecosistema Android: <strong style="color: #FFF;">Spotify, YouTube, TikTok, Instagram y WhatsApp</strong>. Sin hilos de telemetría devorando ciclos de CPU, sin popups comerciales y con fondos OLED puros a 120Hz.
          </p>

          <div style="display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-start;">
            <a href="#apps" class="raycast-btn raycast-btn-primary">
              <span>Examinar las 5 Apps</span>
              <kbd>↓</kbd>
            </a>
            <a href="https://github.com/NikkoWebDev/nt-suite" target="_blank" rel="noopener" class="raycast-btn raycast-btn-secondary">
              <span>Clonar Monorepo</span>
              <kbd>git</kbd>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==============================================================================
         RAYCAST HARDWARE TELEMETRY BENTO
         ============================================================================== -->
    <section id="telemetry" style="padding: 60px 0 80px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <div>
          <div class="koto-numeral">01.0 // TELEMETRÍA EN DISPOSITIVO</div>
          <h2 class="font-editorial" style="font-size: 2.4rem; color: #FFF; margin-top: 4px;">Mediciones Reales en Snapdragon 888 / Exynos</h2>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-muted);">
          BENCHMARK PROFILE: SAMSUNG SM-G990B • CACHYOS BUILD HOST
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        
        <!-- Metric 1: OLED Pure -->
        <div class="raycast-card" style="padding: 28px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span class="font-mono" style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">Subpíxeles Físicos</span>
            <span class="koto-badge active-mint">OLED 0.000 cd/m²</span>
          </div>
          <div class="font-editorial" style="font-size: 3.2rem; color: #FFF; line-height: 1;">#000000</div>
          <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.5; margin-top: 12px;">
            En lugar de grises oscuros lavados (<code class="font-mono">#121212</code>), los diodos emisores de luz se apagan por completo. Consumo de panel reducido en un 38% a 120Hz.
          </p>
        </div>

        <!-- Metric 2: Thermal Delta -->
        <div class="raycast-card" style="padding: 28px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span class="font-mono" style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">Alivio Térmico</span>
            <span class="koto-badge active-cyan">-4.2°C Delta</span>
          </div>
          <div class="font-editorial" style="font-size: 3.2rem; color: var(--accent-cyan); line-height: 1;">36.1°C</div>
          <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.5; margin-top: 12px;">
            Al purgar los recolectores de analítica (Sentry, AppsFlyer, Facebook Graph), la GPU y los núcleos Cortex-X1 operan sin entrar en thermal throttling.
          </p>
        </div>

        <!-- Metric 3: RAM Footprint -->
        <div class="raycast-card" style="padding: 28px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span class="font-mono" style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">Ahorro de Memoria</span>
            <span class="koto-badge active-crimson">-68% RAM</span>
          </div>
          <div class="font-editorial" style="font-size: 3.2rem; color: #FFF; line-height: 1;">114 MB</div>
          <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.5; margin-top: 12px;">
            La app nativa de Spotify consume hasta 480MB en background. Spotin't corre en Jetpack Compose puro con una huella base de solo 114MB.
          </p>
        </div>

        <!-- Metric 4: Keystore PKCS12 -->
        <div class="raycast-card" style="padding: 28px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <span class="font-mono" style="font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase;">Firma de Compilación</span>
            <span class="koto-badge active-violet">Zero Root</span>
          </div>
          <div class="font-editorial" style="font-size: 3.2rem; color: var(--accent-violet); line-height: 1;">10,000 d</div>
          <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.5; margin-top: 12px;">
            Certificados RSA-4096 persistentes para cada aplicación. Actualizaciones in situ sin perder credenciales ni bases de datos locales.
          </p>
        </div>

      </div>
    </section>

    <!-- ==============================================================================
         APPS SHOWCASE: 5 DEDICATED ARCHITECTURE PANELS
         ============================================================================== -->
    <section id="apps" style="padding: 40px 0 100px;">
      
      <!-- Section Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 50px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 24px;">
        <div>
          <div class="koto-numeral">02.0 // REPOSITORIO DE APLICACIONES</div>
          <h2 class="koto-huge-title" style="font-size: clamp(2.5rem, 5vw, 4.2rem);">
            LAS 5 ARQUITECTURAS
          </h2>
        </div>
        <div style="display: flex; gap: 8px;">
          <span class="koto-badge">Usa las teclas <kbd>1</kbd> a <kbd>5</kbd> para inspeccionar</span>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 40px;">

        <!-- ==========================================
             01. SPOTIN'T (NATIVE KOTLIN & COMPOSE)
             ========================================== -->
        <article id="app-1" class="raycast-card card-spotint" style="padding: 44px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 20px;">
              <img src="/icons/spotint.png" alt="Spotin't Icon" style="width: 64px; height: 64px; border-radius: 16px; border: 1px solid rgba(0, 245, 160, 0.4); background: #000;" />
              <div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="koto-numeral" style="color: var(--accent-mint);">01 // SPOTIN'T</span>
                  <span class="koto-badge active-mint">Nativo Kotlin 2.2</span>
                  <span class="koto-badge">Compose 1.7</span>
                </div>
                <h3 class="font-editorial" style="font-size: 2.8rem; color: #FFF; margin-top: 4px;">
                  Música Pura. Cero Distracciones.
                </h3>
              </div>
            </div>

            <div style="display: flex; gap: 10px;">
              <kbd style="height: 28px; padding: 0 10px; font-size: 0.85rem;">[1]</kbd>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 40px; align-items: center;">
            <div>
              <p style="font-size: 1.15rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 24px;">
                Construida desde cero sin tocar el binario oficial. Utiliza Jetpack Compose y Media3 ExoPlayer para una experiencia de audio limpia. Se eliminaron podcasts patrocinados, recomendaciones forzadas y promociones invasivas.
              </p>

              <!-- Feature Matrix -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px;">
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-mint); font-weight: 600;">AUDIO ENGINE</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Media3 ExoPlayer Hi-Fi</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-mint); font-weight: 600;">UI TOOLKIT</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Mint Glass 2.0 Tokens</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-mint); font-weight: 600;">BACKGROUND</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Audio Focus Persistente</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-mint); font-weight: 600;">PUBLICIDAD</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">0% Cero Banners</div>
                </div>
              </div>

              <!-- CLI Execution Block -->
              <div class="spec-box">
                <span class="prompt">$</span>cd Spotin't/spotui-src && ./gradlew assembleDebug<br />
                <span style="color: var(--text-muted);"># Compila el APK nativo firmado con Java 21 OpenJDK</span>
              </div>
            </div>

            <!-- UI Showcase Image -->
            <div style="position: relative; border-radius: 16px; overflow: hidden; border: 1px solid rgba(0, 245, 160, 0.2); box-shadow: 0 20px 40px rgba(0,0,0,0.8);">
              <img src="/images/spotint_home.png" alt="Spotin't UI" style="width: 100%; display: block; object-fit: cover;" />
              <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 16px 20px; background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.9) 100%); display: flex; justify-content: space-between; align-items: center;">
                <span class="font-mono" style="font-size: 0.8rem; color: var(--accent-mint);">spotint_home.png • 120Hz Render</span>
                <span style="font-size: 0.75rem; color: var(--text-muted);">Dark Obsidian</span>
              </div>
            </div>
          </div>
        </article>

        <!-- ==========================================
             02. YOUTUN'T (REVANCED V4.16 ENGINE)
             ========================================== -->
        <article id="app-2" class="raycast-card card-youtunt" style="padding: 44px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 20px;">
              <img src="/icons/youtunt.png" alt="Youtun't Icon" style="width: 64px; height: 64px; border-radius: 16px; border: 1px solid rgba(255, 51, 102, 0.4); background: #000;" />
              <div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="koto-numeral" style="color: var(--accent-crimson);">02 // YOUTUN'T</span>
                  <span class="koto-badge active-crimson">ReVanced Patches v4.16</span>
                  <span class="koto-badge">SponsorBlock Integrado</span>
                </div>
                <h3 class="font-editorial" style="font-size: 2.8rem; color: #FFF; margin-top: 4px;">
                  Sin Anuncios. Sin Shorts Invasivos.
                </h3>
              </div>
            </div>

            <div style="display: flex; gap: 10px;">
              <kbd style="height: 28px; padding: 0 10px; font-size: 0.85rem;">[2]</kbd>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 40px; align-items: center;">
            <div>
              <p style="font-size: 1.15rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 24px;">
                El motor de video de Google despojado de toda fricción comercial. Reproducción nativa en segundo plano con pantalla apagada, salto automático de patrocinios dentro del video, y eliminación radical del botón y carrusel de Shorts.
              </p>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px;">
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-crimson); font-weight: 600;">SPONSORBLOCK</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Salto de promos en video</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-crimson); font-weight: 600;">BACKGROUND PLAY</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">PiP + Pantalla Bloqueada</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-crimson); font-weight: 600;">ALGORITMO</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Shorts Ocultos por Defecto</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-crimson); font-weight: 600;">DISPATCHER</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">./youtunt build s21</div>
                </div>
              </div>

              <div class="spec-box">
                <span class="prompt">$</span>./Youtun't/youtunt verify<br />
                <span style="color: var(--accent-crimson);">✔ 12 parches verificados • SHA256 integrity ok • JDK 21 Ready</span>
              </div>
            </div>

            <!-- Terminal Mockup -->
            <div style="background: #080A0D; border: 1px solid rgba(255, 51, 102, 0.25); border-radius: 16px; padding: 24px; font-family: var(--font-mono); font-size: 0.82rem;">
              <div style="display: flex; gap: 6px; margin-bottom: 16px;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #FF5F56;"></span>
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #FFBD2E;"></span>
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #27C93F;"></span>
                <span style="margin-left: 10px; color: var(--text-muted);">youtunt-cli — verified output</span>
              </div>
              <div style="color: var(--accent-crimson); margin-bottom: 8px;">[+] Injecting SponsorBlock bytecode...</div>
              <div style="color: var(--text-secondary); margin-bottom: 4px;">[+] Stripping Shorts navigation tab from XML...</div>
              <div style="color: var(--text-secondary); margin-bottom: 4px;">[+] Overriding MicroG GmsCore intent bindings...</div>
              <div style="color: var(--text-secondary); margin-bottom: 4px;">[+] Compiling DEX with D8 / Smali backend...</div>
              <div style="color: var(--accent-mint); margin-top: 12px;">[SUCCESS] youtunt-s21-release.apk ready (Zero Bloat)</div>
            </div>
          </div>
        </article>

        <!-- ==========================================
             03. TIKTON'T (FEED FILTER & PURGED LIVES)
             ========================================== -->
        <article id="app-3" class="raycast-card card-tiktont" style="padding: 44px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 20px;">
              <img src="/icons/tiktont.png" alt="Tikton't Icon" style="width: 64px; height: 64px; border-radius: 16px; border: 1px solid rgba(0, 229, 255, 0.4); background: #000;" />
              <div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="koto-numeral" style="color: var(--accent-cyan);">03 // TIKTON'T</span>
                  <span class="koto-badge active-cyan">Feed Filter Engine</span>
                  <span class="koto-badge">Cero ByteDance Telemetry</span>
                </div>
                <h3 class="font-editorial" style="font-size: 2.8rem; color: #FFF; margin-top: 4px;">
                  Solo Videos Reales. Cero Tiendas ni Lives.
                </h3>
              </div>
            </div>

            <div style="display: flex; gap: 10px;">
              <kbd style="height: 28px; padding: 0 10px; font-size: 0.85rem;">[3]</kbd>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 40px; align-items: center;">
            <div>
              <p style="font-size: 1.15rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 24px;">
                El feed de ByteDance filtrado con bisturí. Se eliminan las transmisiones en vivo que saturan el scroll, los botones de TikTok Shop, las marcas de agua forzadas en descargas y la prohibición artificial de hacer capturas de pantalla.
              </p>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px;">
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-cyan); font-weight: 600;">LIVE FILTER</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Cero transmisiones NPC</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-cyan); font-weight: 600;">WATERMARK FREE</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Descarga limpia en MP4</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-cyan); font-weight: 600;">PRIVACY</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Tracking Sentry bloqueado</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-subtle); padding: 14px; border-radius: 10px;">
                  <div class="font-mono" style="font-size: 0.76rem; color: var(--accent-cyan); font-weight: 600;">SCREENSHOTS</div>
                  <div style="font-size: 0.95rem; font-weight: 600; color: #FFF; margin-top: 2px;">Sin detección ni bloqueo</div>
                </div>
              </div>

              <div class="spec-box">
                <span class="prompt">$</span>./Tikton't/tiktont verify<br />
                <span style="color: var(--accent-cyan);">✔ Feed Filter, Sanitize sharing links & Watermark patches active</span>
              </div>
            </div>

            <div style="background: #080C10; border: 1px solid rgba(0, 229, 255, 0.25); border-radius: 16px; padding: 24px; font-family: var(--font-mono); font-size: 0.82rem;">
