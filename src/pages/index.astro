---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Ambient Top Glows -->
  <div style="position: absolute; top: 0; left: 20%; width: 450px; height: 350px; background: radial-gradient(circle, rgba(0, 229, 255, 0.15) 0%, transparent 70%); filter: blur(80px); pointer-events: none;"></div>
  <div style="position: absolute; top: 100px; right: 15%; width: 500px; height: 400px; background: radial-gradient(circle, rgba(255, 42, 95, 0.10) 0%, transparent 70%); filter: blur(90px); pointer-events: none;"></div>

  <!-- Header -->
  <header style="position: sticky; top: 16px; z-index: 50; padding: 0 24px; max-width: 1240px; margin: 0 auto;">
    <div class="prism-card" style="padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; border-radius: 9999px;">
      <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
        <span style="display: inline-flex; width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, rgba(0, 245, 160, 0.2), rgba(0, 229, 255, 0.2)); border: 1px solid rgba(255, 255, 255, 0.25); align-items: center; justify-content: center; font-weight: 800; color: #FFF; font-family: var(--font-display);">
          n't
        </span>
        <span class="font-display" style="font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em;">
          nt.<span style="color: var(--mint);">nikko.dev</span>
        </span>
      </a>

      <nav style="display: flex; align-items: center; gap: 28px;">
        <a href="#apps" style="color: var(--text-mid); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s;">Apps</a>
        <a href="#hardware" style="color: var(--text-mid); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s;">S21 FE</a>
        <a href="#terminal" style="color: var(--text-mid); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s;">CLI Builds</a>
      </nav>

      <a href="https://github.com/NikkoWebDev/nt-suite" target="_blank" rel="noopener" class="badge badge-cyan" style="text-decoration: none; padding: 8px 16px;">
        <span>GitHub Suite</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
    </div>
  </header>

  <main style="max-width: 1240px; margin: 0 auto; padding: 50px 24px 100px;">

    <!-- Hero Section -->
    <section style="padding: 60px 0 70px;">
      <div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
        <span class="badge badge-mint">Android De-bloated Suite</span>
        <span class="badge badge-crimson">Cero Anuncios</span>
        <span class="badge badge-cyan">Snapdragon & Exynos Tuned</span>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: 32px; align-items: start;">
        <div>
          <h1 class="font-display" style="font-size: clamp(3rem, 6.5vw, 5.2rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 24px;">
            El hardware es tuyo.<br />
            <span style="background: linear-gradient(90deg, #FFFFFF 0%, var(--mint) 45%, var(--cyan) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
              Las apps ya no mandan.
            </span>
          </h1>

          <p style="font-size: 1.25rem; line-height: 1.6; color: var(--text-mid); max-width: 780px; margin-bottom: 36px;">
            YouTube, Instagram, WhatsApp, Spotify y TikTok convertidas en herramientas limpias, rápidas y privadas. Sin rastreadores comerciales, sin botones forzados de Meta AI y con fondos OLED puros para pantallas a 120 Hz.
          </p>

          <div style="display: flex; gap: 16px; flex-wrap: wrap;">
            <a href="#apps" class="btn-primary">
              <span>Explorar las 5 apps</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
            </a>
            <a href="https://github.com/NikkoWebDev/nt-suite" target="_blank" rel="noopener" class="btn-ghost">
              <span>Repositorio en GitHub</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 50px;">
        <div class="prism-card" style="padding: 20px 24px; border-left: 3px solid var(--mint);">
          <div class="font-mono" style="font-size: 0.8rem; color: var(--text-low); text-transform: uppercase;">Publicidad & Trackers</div>
          <div class="font-display" style="font-size: 2rem; font-weight: 800; color: var(--text-pure); margin-top: 4px;">0 Bloat</div>
          <div style="font-size: 0.85rem; color: var(--text-mid); margin-top: 4px;">Ni banners ni sugerencias invasivas</div>
        </div>

        <div class="prism-card" style="padding: 20px 24px; border-left: 3px solid var(--cyan);">
          <div class="font-mono" style="font-size: 0.8rem; color: var(--text-low); text-transform: uppercase;">Tasa de Refresco</div>
          <div class="font-display" style="font-size: 2rem; font-weight: 800; color: var(--text-pure); margin-top: 4px;">120 FPS</div>
          <div style="font-size: 0.85rem; color: var(--text-mid); margin-top: 4px;">Dynamic AMOLED sin caída de frames</div>
        </div>

        <div class="prism-card" style="padding: 20px 24px; border-left: 3px solid var(--crimson);">
          <div class="font-mono" style="font-size: 0.8rem; color: var(--text-low); text-transform: uppercase;">Consumo en Pantalla</div>
          <div class="font-display" style="font-size: 2rem; font-weight: 800; color: var(--text-pure); margin-top: 4px;">-35% Batería</div>
          <div style="font-size: 0.85rem; color: var(--text-mid); margin-top: 4px;">Subpíxeles negros apagados físicamente</div>
        </div>

        <div class="prism-card" style="padding: 20px 24px; border-left: 3px solid var(--violet);">
          <div class="font-mono" style="font-size: 0.8rem; color: var(--text-low); text-transform: uppercase;">Seguridad</div>
          <div class="font-display" style="font-size: 2rem; font-weight: 800; color: var(--text-pure); margin-top: 4px;">Zero Root</div>
          <div style="font-size: 0.85rem; color: var(--text-mid); margin-top: 4px;">Keystores persistentes y bytecode limpio</div>
        </div>
      </div>
    </section>

    <!-- Apps Bento Grid -->
    <section id="apps" style="padding: 60px 0;">
      <div style="margin-bottom: 40px;">
        <span class="badge badge-mint" style="margin-bottom: 12px;">Ecosistema</span>
        <h2 class="font-display" style="font-size: 2.8rem; font-weight: 800; letter-spacing: -0.03em;">Las 5 Apps de la Suite</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px;">

        <!-- 1. Spotin't (Hero Card: 12 Columns Full) -->
        <div class="prism-card app-spotint" style="grid-column: span 12; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center; border-color: rgba(0, 245, 160, 0.25);">
          <div>
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px;">
              <img src="/icons/spotint.png" alt="Spotin't" style="width: 52px; height: 52px; border-radius: 14px; border: 1px solid rgba(0, 245, 160, 0.35); background: #030708;" />
              <div>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <h3 class="font-display" style="font-size: 2rem; font-weight: 800; color: #FFF;">Spotin't</h3>
                  <span class="badge badge-mint">Nativo Kotlin 2.2</span>
                </div>
                <div style="color: var(--mint); font-size: 0.95rem; font-weight: 500;">Música pura en Jetpack Compose • Cero podcasts ni audiolibros</div>
              </div>
            </div>

            <p style="color: var(--text-mid); line-height: 1.6; font-size: 1.05rem; margin-bottom: 24px;">
              Un cliente alternativo de Spotify construido desde cero con Jetpack Compose y Media3. Soporta streaming FLAC de alta resolución mediante fallback automático a YouTube Music (InnerTube), con extracción de paleta en segundo plano y mini-player flotante.
            </p>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 28px;">
              <div style="background: rgba(0, 0, 0, 0.4); padding: 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
                <div class="font-mono" style="font-size: 0.75rem; color: var(--text-low);">PESO APK</div>
                <div class="font-display" style="font-size: 1.25rem; font-weight: 700; color: var(--mint); margin-top: 2px;">24 MB <span style="font-size: 0.8rem; color: var(--text-low); font-weight: 400;">(vs 100MB+ Spotify)</span></div>
              </div>
              <div style="background: rgba(0, 0, 0, 0.4); padding: 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
                <div class="font-mono" style="font-size: 0.75rem; color: var(--text-low);">FIDELIDAD DE AUDIO</div>
                <div class="font-display" style="font-size: 1.25rem; font-weight: 700; color: var(--text-pure); margin-top: 2px;">FLAC 24-bit / 96k</div>
              </div>
            </div>

            <div style="display: flex; gap: 14px; flex-wrap: wrap;">
              <a href="https://github.com/NikkoWebDev/nt-suite/tree/main/Spotin't" target="_blank" rel="noopener" class="btn-ghost" style="padding: 10px 18px; font-size: 0.88rem;">
                <span>Ver código en Spotin't</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            </div>
          </div>

          <div style="border-radius: 20px; overflow: hidden; border: 1px solid rgba(0, 245, 160, 0.3); box-shadow: 0 15px 35px rgba(0,0,0,0.8);">
            <img src="/images/spotint_showcase.png" alt="Spotin't UI Showcase" style="width: 100%; height: auto; display: block;" />
          </div>
        </div>

        <!-- 2. Youtun't (Crimson Card: 6 Columns) -->
        <div class="prism-card app-youtunt" style="grid-column: span 6; padding: 36px; border-color: rgba(255, 42, 95, 0.25);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="/icons/youtunt.png" alt="Youtun't" style="width: 46px; height: 46px; border-radius: 12px; border: 1px solid rgba(255, 42, 95, 0.4); background: #06080B;" />
              <div>
                <h3 class="font-display" style="font-size: 1.7rem; font-weight: 800; color: #FFF;">Youtun't</h3>
                <span class="badge badge-crimson">ReVanced v6</span>
              </div>
            </div>
            <span class="font-mono" style="font-size: 0.78rem; color: var(--crimson);">VP9 HARDWARE</span>
          </div>

          <p style="color: var(--text-mid); font-size: 0.98rem; line-height: 1.6; margin-bottom: 20px;">
            Compilación de YouTube que erradica por completo los anuncios de video, los Shorts y las secciones comerciales. Integra SponsorBlock, reproducción en segundo plano y seekbar color menta neón sobre fondo Dark Obsidian.
          </p>

          <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--crimson);">✓</span> SponsorBlock nativo con omisión de patrocinios
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--crimson);">✓</span> Erradicación total de Shorts en home y widgets
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--crimson);">✓</span> Decodificación VP9 por hardware (chip 4°C más frío)
            </div>
          </div>

          <div style="background: rgba(0, 0, 0, 0.5); padding: 12px 16px; border-radius: 10px; border: 1px solid rgba(255, 42, 95, 0.2);">
            <code class="font-mono" style="font-size: 0.82rem; color: #FDA4AF;">$ ./youtunt build s21</code>
          </div>
        </div>

        <!-- 3. Tikton't (Cyan Card: 6 Columns) -->
        <div class="prism-card app-tiktont" style="grid-column: span 6; padding: 36px; border-color: rgba(0, 229, 255, 0.25);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="/icons/tiktont.png" alt="Tikton't" style="width: 46px; height: 46px; border-radius: 12px; border: 1px solid rgba(0, 229, 255, 0.4); background: #06080B;" />
              <div>
                <h3 class="font-display" style="font-size: 1.7rem; font-weight: 800; color: #FFF;">Tikton't</h3>
                <span class="badge badge-cyan">ReVanced v6</span>
              </div>
            </div>
            <span class="font-mono" style="font-size: 0.78rem; color: var(--cyan);">CLEAR DISPLAY</span>
          </div>

          <p style="color: var(--text-mid); font-size: 0.98rem; line-height: 1.6; margin-bottom: 20px;">
            13 parches oficiales verificados contra el bundle vivo. Oculta el 100% de la publicidad, livestreams y ruido algorítmico, desbloqueando descargas limpias sin marca de agua y control de velocidad global.
          </p>

          <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--cyan);">✓</span> Modo pantalla limpia persistente (cero iconos estorbando)
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--cyan);">✓</span> Descarga directa de videos sin marca de agua
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--cyan);">✓</span> Desactivación de Sentry Telemetry y trackers de ByteDance
            </div>
          </div>

          <div style="background: rgba(0, 0, 0, 0.5); padding: 12px 16px; border-radius: 10px; border: 1px solid rgba(0, 229, 255, 0.2);">
            <code class="font-mono" style="font-size: 0.82rem; color: #7DD3FC;">$ ./tiktont build s21</code>
          </div>
        </div>

        <!-- 4. Instan't (Violet Card: 6 Columns) -->
        <div class="prism-card app-instant" style="grid-column: span 6; padding: 36px; border-color: rgba(168, 85, 247, 0.25);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="/icons/instant.png" alt="Instan't" style="width: 46px; height: 46px; border-radius: 12px; border: 1px solid rgba(168, 85, 247, 0.4); background: #06080B;" />
              <div>
                <h3 class="font-display" style="font-size: 1.7rem; font-weight: 800; color: #FFF;">Instan't</h3>
                <span class="badge badge-violet">LSPatch L2</span>
              </div>
            </div>
            <span class="font-mono" style="font-size: 0.78rem; color: var(--violet);">THEME SEEDER</span>
          </div>

          <p style="color: var(--text-mid); font-size: 0.98rem; line-height: 1.6; margin-bottom: 20px;">
            Instagram sin anuncios ni distracciones. Un módulo inyector (`ThemeSeeder`) autosiémbra 15 slots de paleta Mint Glass en SharedPreferences al arrancar. Erradica por completo Meta AI y añade Ghost Mode completo.
          </p>

          <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--violet);">✓</span> Erradicación del botón flotante y sugerencias de Meta AI
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--violet);">✓</span> Ghost Mode: visto oculto en DMs, historias y typing
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--violet);">✓</span> Anti-delete de mensajes directos revocados
            </div>
          </div>

          <div style="background: rgba(0, 0, 0, 0.5); padding: 12px 16px; border-radius: 10px; border: 1px solid rgba(168, 85, 247, 0.2);">
            <code class="font-mono" style="font-size: 0.82rem; color: #D8B4FE;">$ ./instant build s21</code>
          </div>
        </div>

        <!-- 5. Wasapn't (Teal/Amber Card: 6 Columns) -->
        <div class="prism-card app-wasapnt" style="grid-column: span 6; padding: 36px; border-color: rgba(16, 185, 129, 0.25);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <img src="/icons/wasapnt.png" alt="Wasapn't" style="width: 46px; height: 46px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.4); background: #06080B;" />
              <div>
                <h3 class="font-display" style="font-size: 1.7rem; font-weight: 800; color: #FFF;">Wasapn't</h3>
                <span class="badge badge-amber">En Desarrollo</span>
              </div>
            </div>
            <span class="font-mono" style="font-size: 0.78rem; color: var(--emerald);">E2EE SIGNAL PRESERVED</span>
          </div>

          <p style="color: var(--text-mid); font-size: 0.98rem; line-height: 1.6; margin-bottom: 20px;">
            Privacidad pasiva a nivel de memoria RAM con WaEnhancerX. Preserva los mensajes revocados en la base SQLite local y cancela la expiración de fotos efímeras sin tocar las llaves criptográficas de Signal.
          </p>

          <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-high);">
              <span style="color: var(--emerald);">✓</span> Cifrado Signal Protocol 100% oficial e intacto
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--emerald);">
              <span style="color: var(--emerald);">✓</span> Bypass de visualización única (View-Once ilimitado)
            </div>
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--emerald);">
              <span style="color: var(--emerald);">✓</span> Canales de WhatsApp preservados explícitamente
            </div>
          </div>

          <div style="background: rgba(0, 0, 0, 0.5); padding: 12px 16px; border-radius: 10px; border: 1px solid rgba(16, 185, 129, 0.2);">
            <code class="font-mono" style="font-size: 0.82rem; color: #6EE7B7;">$ ./wasapnt status && ./wasapnt build</code>
          </div>
        </div>

      </div>
    </section>

    <!-- Hardware Section (S21 FE) -->
    <section id="hardware" style="padding: 60px 0;">
      <div class="prism-card" style="padding: 48px; border-radius: 32px; background: linear-gradient(135deg, rgba(14, 19, 26, 0.85) 0%, rgba(4, 6, 8, 0.95) 100%);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 24px; margin-bottom: 36px;">
          <div style="max-width: 680px;">
            <span class="badge badge-crimson" style="margin-bottom: 14px;">Thermal & Power Engineering</span>
            <h2 class="font-display" style="font-size: 2.6rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 14px;">
              El cuello de botella de los 5 nm
            </h2>
            <p style="color: var(--text-mid); font-size: 1.05rem; line-height: 1.6;">
              Tanto el Snapdragon 888 como el Exynos 2100 en el S21 FE operan en una ventana térmica muy estrecha. Las apps comerciales abusan de la GPU con capas invisibles y mantienen los núcleos a máxima frecuencia con telemetría en segundo plano.
            </p>
          </div>

          <div class="font-mono" style="background: rgba(0,0,0,0.6); padding: 16px 20px; border-radius: 14px; border: 1px solid rgba(255, 42, 95, 0.3);">
            <div style="font-size: 0.75rem; color: var(--text-low);">TEMPERATURA EN VIDEO</div>
            <div style="font-size: 1.8rem; font-weight: 700; color: var(--crimson);">33°C <span style="font-size: 0.8rem; color: var(--text-low); font-weight: 400;">(vs 44°C oficial)</span></div>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
          <div style="background: rgba(0,0,0,0.4); padding: 22px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.06);">
            <div class="font-mono" style="color: var(--cyan); font-size: 0.82rem; margin-bottom: 6px;">DYNAMIC AMOLED 2X</div>
            <h4 class="font-display" style="font-size: 1.15rem; font-weight: 700; margin-bottom: 8px;">Negros al 0% en OLED</h4>
            <p style="font-size: 0.88rem; color: var(--text-mid); line-height: 1.5;">El fondo Obsidian (#040608) apaga físicamente los subpíxeles orgánicos de la pantalla a 120Hz, reduciendo drásticamente el consumo del panel.</p>
          </div>

          <div style="background: rgba(0,0,0,0.4); padding: 22px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.06);">
            <div class="font-mono" style="color: var(--mint); font-size: 0.82rem; margin-bottom: 6px;">HARDWARE MEDIACODEC</div>
            <h4 class="font-display" style="font-size: 1.15rem; font-weight: 700; margin-bottom: 8px;">Decodificación Nativa</h4>
            <p style="font-size: 0.88rem; color: var(--text-mid); line-height: 1.5;">Forzar decodificación VP9 directa en hardware evita que los núcleos de alto rendimiento despierten para procesar video o notas de voz.</p>
          </div>

          <div style="background: rgba(0,0,0,0.4); padding: 22px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.06);">
            <div class="font-mono" style="color: var(--violet); font-size: 0.82rem; margin-bottom: 6px;">BACKGROUND DOZE</div>
            <h4 class="font-display" style="font-size: 1.15rem; font-weight: 700; margin-bottom: 8px;">Deep Sleep Real</h4>
